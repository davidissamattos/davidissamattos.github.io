&lt;script src="https://davidissamattos.github.io/js/osmd/opensheetmusicdisplay.min.js"&gt;&lt;/script&gt;&lt;div class="musicxml-metadata"&gt;
 &lt;div class="musicxml-summary-break"&gt;&lt;/div&gt;
